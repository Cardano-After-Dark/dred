# COPY ENV EXAMPLE TO ENV
# 
# Local DRED Environment Configuration
# This file is automatically loaded by dotenv when running local DRED server
# Used by: bin/dredServer (import dotenv from 'dotenv/config')
# Launch with: make local-dred-run (from devops/ directory)
#
# Configuration for UK Server HTTP/Insecure Mode testing

# Redis connection
REDIS_URL=redis://localhost:6379

# Server configuration
DRED_PORT=3029
DRED_HOST=0.0.0.0
SERVER_IP=127.0.0.1

# Environment mode (test allows insecure HTTP)
NODE_ENV=test

# Logging (verbose for testing)
LOGGING=default:info,discovery:debug,replication:debug

# Node identification
DRED_NODE_ID=local-dev

# Blockfrost API Key (preprod)
BF_API_KEY=preprod_YOU_API_KEY_HERE

# Cardano Network
CARDANO_NETWORK=preprod

# Discovery method (true = StaticHostDiscovery, false = NeighborhoodDiscovery)
USE_STATIC_DISCOVERY=true

# Protocol configuration - HTTP for UK server testing
# NOTE: The hybrid approach allows insecure HTTP in any environment
DRED_USE_INSECURE=true
