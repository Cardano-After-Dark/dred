module NeighborhoodData
import {
    TODO,
    REQT,
    bREQT
} from StellarHeliosHelpers

// import {
//     AbstractSettingsForNodeOperator as ProtocolSettings
// } from NeighborhoodSettings

enum SubscriptionFeeFrequency {
    Epoch {
        fee: Value
    }
    Monthly {
        fee: Value
    }
    Yearly {
        fee: Value
    }
}

enum FeeSource {
    EndUser
    SponsorContract {
        sponsorContract: ScriptHash // or Address?
    }
    // CapoRole {
    //     role: String
    // }
}

enum RevenueModel {
    TransactionBased {
        minTxFee: Value
        maxTxFee: Option[Value]
        chargeTo: FeeSource
    }

    Subscription {
        subscriptionFee: []SubscriptionFeeFrequency
    }
}

struct AppInfo {
    url: String
    revenueModel: []RevenueModel
    name: String
    description: String
}

struct UpdateInfo {
    name: String "nm"
    description: String "dsc"
    url: String "url"
}

struct NodeOpsInfo {
    minNodes: Int "cMin"
    maxNodes: Int "cMax"
    minNodeOperatorStake: Value "minStk"
    minUptime: Int "minUpt"
}

enum NeighborhoodState {
    Preproduction
    Active
    UpdatePending
    UpdateDisputed
    Retired
}

struct NeighborhoodData {
    id : ByteArray "@id" // = "nbhd-XXXXyyyyZZZZ"
    type : String "tpe" // = "nbhd"

    memberToken: String "mt"
    state: NeighborhoodState "st"
    appInfo: AppInfo "app"
    opsInfo: NodeOpsInfo "ops"
    updateInfo: Option[UpdateInfo] "upd"

    func validate(self) -> Bool {
        assert(true || /*never executed*/ self == self, "no way");
        // assert(self.memberToken != null, "memberToken is null");
        true
    }

    func validateActivation(self,
        nextData: NeighborhoodData
    ) -> Bool {
        print("a");
        assert(nextData.memberToken == self.memberToken, "memberToken cannot be changed");
        print("b");
        self.state.switch {
            Preproduction => print("  -- activating a Preproduction neighborhood..."),
            UpdatePending => {
                TODO("validate the updateInfo");
                print("  -- activating an UpdatePending neighborhood...")
            },
            _ => error("neighborhood is not in need of activation")
        }
        nextData.state.switch {
            Active => print("  -- ok, next state is Active"),
            _ => error("neighborhood must switch to Active state")
        }
        REQT("rejects if the memberToken is changed");
        assert(nextData.memberToken == self.memberToken, "memberToken cannot be changed");
        
        true
    }
}

