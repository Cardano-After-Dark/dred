module NodeRegistrationData

import {
    TODO,
    REQT,
    bREQT
} from StellarHeliosHelpers

import {
    tx, 
    get_current_input,
    get_current_validator_hash,
    get_cont_outputs
} from ScriptContext

import {
    NodeOperatorSettings,
    NodeOperatorSettingsV1
} from NodeOperatorSettings

enum DredNodeState {
    NeedsValidation {
        // datumHash: ByteArray
        // to validate, a validator should post a Validating txn
        // ... and add themselves to this list, using their own node-reg record id.
        validators: []ByteArray
    }
    Active {
        lastHeartbeat: Time
    }
    NeedsHeartbeats {
        validators: []ByteArray
    }
    Inactive
}

struct NodeDetailsV1 {
    address: String
    port: Int
    pubKey: PubKey
    pubKeyHash: PubKeyHash
}

struct NodeRegistrationData {
    id : ByteArray "@id" // = "dredNode-XXXXyyyyZZZZ"
    type : String "tpe" // = "dredNode"

    memberToken: String "mt"
    state: DredNodeState "state"
    nodeDetails: NodeDetailsV1 "nd"
    // todo
    // nextNodeDetails: NodeDetails "nd'"

    func validate(self) -> Bool {
        assert(true || /*never executed*/ self == self, "no way");
        // assert(self.memberToken != null, "memberToken is null");
        true
    }

    func validateCreation(self) -> Bool {
        print("  -- validating creation details ...");
        // assert(
        //     (self.nodeStatus.lastHeartbeat == Time::new(0)).trace("  -- heartbeat non-zero? "),
        //     "lastHeartbeat must be 0 during creation");
        REQT("state must be NeedsValidation during creation");
        self.state.switch {
            NeedsValidation{validators} => {
                REQT("validators must be empty during creation");
                assert(
                    (validators.length ==0).trace("  -- validators empty? "),
                    "non-zero validators list"
                )
                true
            },
            _ => error("state must be NeedsValidation during creation")
        } &&

        self.validate()
    }
    func unmodifedEssentials(self, nextData: NodeRegistrationData) -> Bool {
        REQT("The essential node details must be unmodified");
        REQT("rejects if nodeDetails are modified")
        assert(
            (self.nodeDetails == nextData.nodeDetails).trace("  -- node details unchanged? "),
            "nodeDetails modified"
        )

        REQT("rejects if memberToken is modified")
        assert(
            (self.memberToken == nextData.memberToken).trace("  -- memberToken unchanged? "),
            "memberToken modified"
        )

        true
    }
    
    func validateUpdate(self, _nextData: NodeRegistrationData) -> Bool {
        // TODO("the lastHeartbeat must be extended by settings.expectedHeartbeatInterval");
        assert(true || /*never executed*/ self == self, "no way");
        // assert(false, "validateUpdate() not implemented yet");
        true
    }

    func checkValidationActivity(self, 
        nextData: NodeRegistrationData, 
        validatorRec: NodeRegistrationData
    ) -> Bool {
        REQT("can't validate own node");
        validatorPkh = validatorRec.nodeDetails.pubKeyHash;
        assert(validatorPkh != self.nodeDetails.pubKeyHash, "can't validate own node");
        REQT("rejects unless in NeedsValidation state");
        oldValidators = self.state.switch {
            NeedsValidation{validators} => {
                print( "   -- NeedsValidation ok");
                validators
            },
            _ => error("node is not in need of validation")
        };
        REQT("rejects if the validator's id is already in the list");
        oldValidators.find_safe(
            (v: ByteArray) -> Bool {  v == validatorRec.id }
        ).switch {
            Some => error("duplicate validation attempt"),
            None => print("  -- ok, additional validation from "+ validatorRec.id.show())
        }
        
        nextData.state.switch {
            NeedsValidation{validators} => {
                REQT("rejects unless the new validator's dredNode-* id is at the head of the new validators list");
                assert(
                    (validators.head == validatorRec.id).trace("  -- new validator's id at head? "), 
                    "expected validator not heading the new validators list "
                )
                REQT("rejects unless the update retains the previous validators verbatim");
                assert(
                    (validators.tail == oldValidators).trace("  -- tail unchanged? "),
                    "creator polluted the tail of validators"
                )
            },
            _ => error("node is not in need of validation")
        }

        self.unmodifedEssentials(nextData)
    }

    func checkActivation(self, nextData: NodeRegistrationData, settings: NodeOperatorSettingsV1) -> Bool {
        REQT("rejects unless in NeedsValidation state");
        self.state.switch {
            NeedsValidation{validators} => {
                // check mark emoji: ✅
                print("  ✅ NeedsValidation: ok");
                needValidations = settings.minValidations;
                validationCount = validators.length;
                REQT("rejects when validations are insufficient");
                print("  -- have "+ validationCount.show() + " validations, need "+ needValidations.show())
                assert(
                    validationCount >= needValidations,
                    "not enough validations to activate the node"
                )
                REQT("rejects activation if txn is not signed by the node operator");
                nodePkh = self.nodeDetails.pubKeyHash;
                print("  -- expecting sig from: "+ nodePkh.show());
                assert(
                    tx.is_signed_by(nodePkh).trace("  -- txn signed by node operator? "),
                    "node must activate itself"
                )
            },
            _ => error("node is not in need of validation")
        }
        REQT("rejects if the node doesn't move to Active state");
        nextData.state.switch {
            Active{lastHeartbeat} => {
                print("  -- state is Active: ok");
                REQT("rejects if the lastHeartbeat is not updated");
                print("  -- lastHeartbeat: "+ lastHeartbeat.show() + " txn time: "+ tx.time_range.show());
                assert(
                    tx.time_range.contains(lastHeartbeat),
                    "wrong heartbeat time"
                )
            },
            _ => error("node must switch to Active state")
        }
        self.unmodifedEssentials(nextData)
    }
}

