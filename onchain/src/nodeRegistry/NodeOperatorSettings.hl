module NodeOperatorSettings

import {
    TODO,
    REQT,
    bREQT
} from StellarHeliosHelpers

struct NodeOperatorSettingsV1 {
    expectedHeartbeatInterval: Duration "ndHbi"
    requiredNodeUptime: Real "ndUpt" // percentage
    minValidations: Int "minVals"

    minNodeRegistrationFee: Value "minFee"
    minNodeOperatorStake: Value "minStk"

    func validate(self) -> Bool {
        REQT("nodeOpSettings: must validate");
        bREQT("reg fee must be positive") &&
        (self.minNodeRegistrationFee.get_lovelace() > 0).trace("reg fee ok? ") &&
        bREQT("minStake must be positive") &&
        (self.minNodeOperatorStake.get_lovelace() > 0).trace("minStake ok? ")
    }
}

enum NodeOperatorSettings {
    V1 { s: NodeOperatorSettingsV1 }
    // V2 { s: NodeOperatorSettingsV2 }

    func validate(self) -> Bool {
        self.switch {
            V1{s} => s.validate()
            // V2{s} => s.validate(),

            // non-exhaustion is an error; don't use a default case.
            // _ => error("invalid node operator settings")
        }
    }
}


struct AbstractSettingsForNodeOperator {
    nodeOpSettings: NodeOperatorSettings "nOp"
}
