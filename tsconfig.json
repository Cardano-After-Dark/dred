{
    "extends": "./ts/tsconfig.base",
    "compilerOptions": {
        "experimentalDecorators": true,
        // "baseUrl": ".",
        "moduleResolution": "node16",
        "module": "Node16",
        "verbatimModuleSyntax": true,
        "paths": {
            "@platform/*": ["./platform/server/*"],
            // "sXXrc/*": ["src/*"]
        }
    },
    "include": [ "src/**/*.ts", "src/**/*.js" ],
    "exclude": [ "src/client", "**/node_modules/" ]
}
