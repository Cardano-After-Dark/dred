import dotenv from 'dotenv/config'

import { NeighborhoodDiscovery } from "../src/peers/NeighborhoodDiscovery.js";
import { StaticHostDiscovery } from "../src/peers/StaticHostDiscovery.js"
import { createServer } from "../src/server/DredServer.js";
import { asyncDelay } from "../src/util/asyncDelay.js";
import path from 'node:path';

//!!!! todo: read config from a JSON file 

init();
async function init() {
    try{
        const nbh = process.env.NEIGHBORHOOD || "dred-dev";
        const serverAddress = process.env.DRED_HOST || "0.0.0.0";
        const serverPort = process.env.DRED_PORT || "3029";

        console.log("🚀 Starting DRED server initialization...");
        
        // TEMPORARY FIX: Use static discovery to avoid on-chain bootstrap issues
        const useStaticDiscovery = process.env.USE_STATIC_DISCOVERY || false;
        
        let discovery;
        if (useStaticDiscovery) {
            console.log("📡 Using StaticHostDiscovery (temporary fix for bootstrap)");
            
            // Define known preprod hosts
            const knownHosts = [
                {
                    address: "74.208.13.84",
                    port: 3029, 
                    serverId: "preprod-us",
                    insecure: true,  // Use HTTP instead of HTTPS
                    publicKey: "temp-key-1",
                    pubKeyHash: "temp-hash-1"
                },
                {
                    address: "217.154.34.155",
                    port: 3029,
                    serverId: "preprod-uk", 
                    insecure: true,  // Use HTTP instead of HTTPS
                    publicKey: "temp-key-2",
                    pubKeyHash: "temp-hash-2"
                }
            ];
            
            discovery = new StaticHostDiscovery({ hosts: knownHosts });
            console.log("✅ StaticHostDiscovery created with", knownHosts.length, "hosts");
        } else {
            console.log("📡 About to call NeighborhoodDiscovery.forNeighborhood:", nbh);
            discovery = await NeighborhoodDiscovery.forNeighborhood(nbh);
            console.log("✅ NeighborhoodDiscovery completed, waiting for hosts:ready");

            const hostsReadyPromise = new Promise((resolve) => {
                discovery.events.once("hosts:ready", resolve)            
            });
            
            const timeoutPromise = new Promise((_, reject) => {
                setTimeout(() => reject(new Error("hosts:ready timeout after 30s")), 30000);
            });
            
            await Promise.race([hostsReadyPromise, timeoutPromise]);
            console.log("✅ hosts:ready event received");
        }

        const hosts = discovery.hosts
        const matchingHost = hosts?.find(host => 
            host.address === serverAddress && parseInt(host.port) === parseInt(serverPort)
        );
    
        console.log("Dred nbh", nbh);
        console.log("Dred serverAddress", serverAddress);
        console.log("Dred serverPort", serverPort);
        
        if (!matchingHost) {
            const availableHosts = hosts?.map(h => `${h.address}:${h.port} (${h.serverId})`).join(', ') || 'none';
            throw new Error(`No host found matching server address ${serverAddress}:${serverPort}. Available hosts: ${availableHosts}`);
        }
        
        // Shows the whole host object, incl address and port
        console.log("Dred server starting on host", matchingHost);
        
        const server = await createServer({ 
            discovery ,
            neighborhood: nbh || "dred-dev",
            waitFor: "minimal",//"healthy",        // boostrapping problem: I need to start at least the first server to be able to connect others
            // connectionSettings: {
    
            // }
        }, matchingHost.serverId, 0);
    
        console.log("Dred server created", server);
    
        const { port, address } = matchingHost;
        await server.listen();

    } catch (error) {
        console.error("❌ DRED startup error:", error.message);
        console.error("❌ Stack trace:", error.stack);
        process.exit(1);
    }

    // console.log(`Dred server listening on port ${port}`);
}
