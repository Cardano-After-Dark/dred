// gives vscode a handle on expected config

{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "paths": {
            "@platform/*": ["../../platform/browser/*"]
        }
    },
    "include": ["index.ts", "../../platform/browser/**/*.ts"]

}
