{
    "$schema": "http://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "strict": true,
        // "noEmit": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "declarationMap": true,
        "sourceMap": true,
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "allowArbitraryExtensions": true,
        "skipLibCheck": true,

        "target": "ESNext",
        "lib": ["esnext", "dom"],
        "module": "nodenext",
        "esModuleInterop": true,
        "types": ["node"],
        "verbatimModuleSyntax": true,

        "moduleResolution": "nodenext",
        "customConditions": ["dev"],
        "baseUrl": ".",
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        // "isolatedModules": false,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "jsx": "preserve",

        "outDir": "./.api-extractor-temp",
        // "outFile": ".api-extractor-temp/raw.d.ts",
        "rootDir": "../..",
        
        // "exactOptionalPropertyTypes": true,        
        "noImplicitAny": false,
        "noErrorTruncation": true,

        // "importHelpers": true,

        // "noResolve": true,

        "disableReferencedProjectLoad": true,
        "paths": {
            "@cardano-after-dark/dred-client": ["./index.ts"],
            "@platform/ReadableStream.js": ["../../platform/browser/ReadableStream.ts"],
            "@platform/ReadableStream": ["../../platform/browser/ReadableStream.ts"],
            "@platform/*": ["../../platform/browser/*"]
        }
        // "plugins": [],
        // "outFile": "dist/index.d.ts",
    },
    "files": [ 
        "./index.ts"
    ],
    // "include": [
    //     "src/**/*.ts",
    //     "src/**/*.hl"
    // ],
    "exclude": [
        "node_modules/**/*",
        "**/node_modules/**/*",
        "../../node_modules/**/*"
    ]
}
