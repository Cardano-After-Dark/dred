# Common DRED Configuration (ENV FILE - NOT COMMITTED)
# Copy this file to '.env' and add your actual BF_API+KEY
# This file contains properties shared across all servers
# Copy to common.env and customize with actual values

# Blockfrost API Key (required)
BF_API_KEY=preprodB0nt..

# Cardano Network
CARDANO_NETWORK=preprod

# DRED Repository Settings
DRED_REPO=https://github.com/Cardano-After-Dark/dred.git
DRED_BRANCH=feature/onchain-nbh-discovery
DRED_PORT=3029

# Redis Configuration
REDIS_MEMORY_LIMIT=512mb

# DRED Operational Settings
DRED_USE_INSECURE=true
USE_STATIC_DISCOVERY=false

# Logging (override per server as needed)
LOGGING=default:info
